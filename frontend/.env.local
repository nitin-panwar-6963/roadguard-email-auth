# RoadGuard AI - Frontend Environment Config (Authentication layer only)
# Fill in the real values from your Supabase project: Project Settings > API
# This file is gitignored — never commit it.

# Supabase project URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Project Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Email domain allowed to sign in / register. Defaults to miet.ac.in if unset.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=miet.ac.in
